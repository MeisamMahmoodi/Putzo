{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm --prefix apps/web install && npm --prefix apps/web run build"
  },
  "deploy": {
    "startCommand": "npm --prefix apps/web run start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
